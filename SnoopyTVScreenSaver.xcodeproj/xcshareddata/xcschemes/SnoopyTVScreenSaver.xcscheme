   <BuildAction parallelizeBuildables="YES" buildImplicitDependencies="YES" buildArchitectures="Automatic">
      <PostActions>
         <ExecutionAction ActionType="Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title="Install Snoopy TV.saver"
               scriptText="set -eu&#10;&#10;DEST=&quot;$HOME/Library/Screen Savers&quot;&#10;PRODUCT=&quot;$TARGET_BUILD_DIR/$FULL_PRODUCT_NAME&quot;&#10;FINAL=&quot;$DEST/$FULL_PRODUCT_NAME&quot;&#10;STAGING_ROOT=&quot;$DEST/.snoopy-saver-installing.$$&quot;&#10;STAGING=&quot;$STAGING_ROOT/$FULL_PRODUCT_NAME&quot;&#10;&#10;if [ ! -d &quot;$PRODUCT&quot; ]; then&#10;  echo &quot;Built saver not found: $PRODUCT&quot; &gt;&amp;2&#10;  exit 1&#10;fi&#10;&#10;mkdir -p &quot;$DEST&quot;&#10;trap 'rm -rf &quot;$STAGING_ROOT&quot;' EXIT&#10;rm -rf &quot;$STAGING_ROOT&quot;&#10;mkdir -p &quot;$STAGING_ROOT&quot;&#10;ditto &quot;$PRODUCT&quot; &quot;$STAGING&quot;&#10;codesign --force --deep --sign - &quot;$STAGING&quot;&#10;codesign --verify --deep --strict &quot;$STAGING&quot;&#10;rm -rf &quot;$FINAL&quot;&#10;mv &quot;$STAGING&quot; &quot;$FINAL&quot;&#10;rm -rf &quot;$STAGING_ROOT&quot;&#10;touch &quot;$FINAL&quot;&#10;codesign --verify --deep --strict &quot;$FINAL&quot;&#10;trap - EXIT&#10;echo &quot;Installed: $FINAL&quot;&#10;">
               <EnvironmentBuildable>
                  <BuildableReference BuildableIdentifier="primary" BlueprintIdentifier="E001" BuildableName="Snoopy TV.saver" BlueprintName="SnoopyTVScreenSaver" ReferencedContainer="container:SnoopyTVScreenSaver.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
